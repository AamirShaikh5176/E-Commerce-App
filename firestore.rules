rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // STRICT DUAL VERIFICATION: Requires BOTH cryptographically signed Firebase Custom Claim AND Firestore Admin Role
    function hasAdminClaim() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function hasAdminFirestoreRole() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAdmin() {
      return hasAdminClaim() && hasAdminFirestoreRole();
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Products & Categories: Public read; Admin write
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /paymentConfig/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users Collection: Strict Role Self-Escalation Lock
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId
                    && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'customer');
      // Normal users CANNOT modify the role field
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
                    || isAdmin();
      allow delete: if isAdmin();

      match /addresses/{addressId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /cart/{productId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /wishlist/{productId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // SuperCoins Wallet: Secure user-specific store credit
      match /wallet/{walletDoc} {
        allow read: if isOwner(userId) || isAdmin();
        // Allow creating/updating with valid balance invariants
        allow create: if isOwner(userId)
                      && request.resource.data.balance >= 0
                      && request.resource.data.lifetimeEarned >= 0
                      && request.resource.data.lifetimeRedeemed >= 0;
        allow update: if (isOwner(userId)
                      && request.resource.data.balance >= 0
                      && request.resource.data.lifetimeEarned - request.resource.data.lifetimeRedeemed == request.resource.data.balance)
                      || isAdmin();
        allow delete: if isAdmin();

        match /transactions/{txnId} {
          allow read: if isOwner(userId) || isAdmin();
          allow create: if isOwner(userId) || isAdmin();
          allow update, delete: if isAdmin();
        }
      }
    }

    // Orders Collection: Customers create/read their own; Admins manage fulfillment
    match /orders/{orderId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Status updates & reward idempotent tracking allowed for owner or Admin
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
